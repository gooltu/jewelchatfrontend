{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "types": [
      "jest"
    ],
    "paths": {
      "@assets/*": [
        "./src/assets/*"
      ],
      "@database/*": [
        "./src/database/*"
      ],
      "@navigation/*": [
        "./src/navigation/*"
      ],
      "@gameserver/*": [
        "./src/gameserver/*"
      ],
      "@chatserver/*": [
        "./src/chatserver/*"
      ],
      "@services/*": [
        "./src/services/*"
      ],
      "@hooks/*": [
        "./src/hooks/*"
      ],
      "@notifications/*": [
        "./src/notifications/*"
      ],
      "@store/*": [
        "./src/store/*"
      ],
      "@components/*": [
        "./src/components/*"
      ],
      "@app-types/*": [
        "./src/types/*"
      ],
      "@config/*": [
        "./src/config/*"
      ]
    }
  },
  "include": [
    "**/*.ts",
    "**/*.tsx"
  ]
}
