# Copy to e2e/.env.local (gitignored) and fill in.
# Use numbers reserved for testing — the server's OTP is hardcoded to 888888,
# so whoever owns a real number here could be signed in as by these tests.
# Every number must match 90000000NN: reset-accounts.mjs refuses anything else.

# --- Account pool (no number may appear twice) ---
# Devices: emulator, iOS simulator, and the two weekly physical phones.
E2E_GROUP_PHONES=emu:9000000001,ios:9000000002,pixel:9000000003,samsung:9000000004
# Bot peers for each platform's bot suites (in the device's phonebook).
E2E_EMU_BOTS=alice:9000000005,bob:9000000006,cara:9000000007
E2E_IOS_BOTS=dan:9000000011,eve:9000000012,finn:9000000013
# Stranger bots (never in any phonebook) for the unknown-sender flows.
E2E_EMU_STRANGERS=9000000008,9000000009,9000000010
E2E_IOS_STRANGERS=9000000014,9000000015,9000000016
# Accounts that go through sign-up (Name + Referral screens) every run.
E2E_SIGNUP_PHONES=emu:9000000098,ios:9000000099
E2E_SIGNUP2_PHONES=emu:9000000096,ios:9000000097
# Never registered: the "unknown referrer" case. Not reset (no PHONE in the name).
E2E_UNKNOWN_REFERRER=9000000089

# --- Admin (JewelChat Admin login) used to reset the pool before each run ---
E2E_ADMIN_EMAIL=
E2E_ADMIN_PASSWORD=

# --- Optional ---
# E2E_GAMESERVER=https://game.jewelchat.net
# E2E_CHATSERVER=wss://chat.jewelchat.net/ws-xmpp
# E2E_GROUP_DEVICES=emu:<serial>,ios:<udid>,pixel:<serial>,samsung:<serial>
